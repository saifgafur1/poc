<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>POC_Tier__c</fullName>
    <description>Gold, Silver or Bronze segmentation of an Account so Sales Ops can segment reports consistently instead of using hand-typed revenue bands. Required by validation when Annual Revenue is above 1,000,000.</description>
    <inlineHelpText>Select Gold, Silver or Bronze. A Tier is required for accounts with Annual Revenue above 1,000,000.</inlineHelpText>
    <label>Account Tier</label>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Gold</fullName>
                <default>false</default>
                <label>Gold</label>
            </value>
            <value>
                <fullName>Silver</fullName>
                <default>false</default>
                <label>Silver</label>
            </value>
            <value>
                <fullName>Bronze</fullName>
                <default>false</default>
                <label>Bronze</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
